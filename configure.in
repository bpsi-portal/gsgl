#		    GL/osmesa.h,
#		    AC_CHECK_LIB([OSMesa], [OSMesaCreateContext],have_osmesa=yes,,$LIBS)
#		    ,)
#	if test x$have_osmesa = xyes; then
#	    AC_DEFINE(HAVE_OSMESA,,[have osmesa])
#	    LIBS="$LIBS -lOSMesa"
#	fi
#fi

#GSGL_LIBS="-lgsgl" 
#GSGL_LIBDEPS="-lz -lfreetype"
#AC_CONFIG_PKGCONFIG_IN(gsgl, [abc], [src])

# Checks for header files.
AC_HEADER_STDC
AC_CHECK_HEADERS([sgtty.h stdlib.h string.h termios.h unistd.h sys/types.h sys/stat.h arpa/inet.h netdb.h sys/socket.h netinet/in.h ctype.h locale.h sys/times.h time.h])

# Checks for typedefs, structures, and compiler characteristics.
AC_CHECK_SIZEOF(int)
AC_C_CONST
AC_TYPE_SIZE_T
AC_STRUCT_TM

# Checks for library functions.
AC_FUNC_MALLOC
AC_FUNC_STAT
AC_FUNC_FORK
AC_FUNC_VPRINTF
AC_HEADER_SYS_WAIT
AC_CHECK_FUNCS([pow putenv regcomp sqrt bzero gethostbyaddr gethostbyname inet_ntoa socket setlocale vsscanf sysconf])

AC_CONFIG_HEADER(src/config.h)

AC_CONFIG_FILES([Makefile src/Makefile src/demo/Makefile src/demo/f77/Makefile src/demo/c/Makefile po/Makefile.in m4/Makefile include/Makefile src/qt/qt_gsglwindow.h src/qt/qt_dialog.h])
		      
AC_OUTPUT
