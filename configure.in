# Process this file with autoconf to produce a configure script.	    
AC_INIT([gsgl],[0.4.17],[akutsu@p-grp.nucleng.kyoto-u.ac.jp])
PACKAGE=gsgl
VERSION=0.4.17
GSGL_VERSION=$VERSION
AM_INIT_AUTOMAKE
AC_SUBST(PACKAGE)
AC_SUBST(VERSION)
AC_DEFINE_UNQUOTED(PACKAGE, "$PACKAGE", [Package name])
AC_DEFINE_UNQUOTED(GSGL_VERSION, "$VERSION", [GSAF/OpenGL version])
AC_DEFINE_UNQUOTED(GSAF_VERSION, "V3.86", [GSAF version])
#shared library versioning
AC_SUBST(GSGL_LIBTOOL, "4:16:4")

# Checks for programs.
AC_PROG_CC
AC_PROG_CXX
 
AC_PROG_INSTALL
AC_PROG_LN_S
AC_PROG_MAKE_SET
AC_PROG_AWK
AC_PROG_F77
AC_PROG_RANLIB
AC_CHECK_PROG(have_LD, ld, yes, no)
if test "x$have_LD" = "xyes" ; then
   LD=ld
   AC_SUBST(LD)
else
 AC_MSG_ERROR([Missing program ld])
fi

# chech for lpr or lp
AC_CHECK_PROG(have_LPR, lpr, yes, no)
if test "x$have_LPR" = "xyes" ; then
   LP=lpr
   AC_SUBST(LP)
else
   AC_CHECK_PROG(have_LP, lp, yes, no)
   if test "x$have_LP" = "xyes" ; then
       LP=lp
       AC_SUBST(LP)
   else
       LP=lpr
       AC_SUBST(LP)
   fi
fi

# Check for fortran77
AC_F77_LIBRARY_LDFLAGS
AC_F77_WRAPPERS

# Check for gettext
ALL_LINGUAS="ja"
AM_GNU_GETTEXT([external])
#AC_CHECK_FUNC(gettext, AC_CHECK_LIB(intl, gettext))
localedir='${datadir}/locale'
AC_SUBST(localedir)

# Check for libtool
#AC_PROG_LIBTOOL
############################################################################
# quoted from http://mail.gnu.org/pipermail/libtool/2002-January/005995.html
############################################################################
# Supporting compilers that write to stderr
#
# Scott Pakin pakin@uiuc.edu
# Sun, 27 Jan 2002 16:39:12 -0600
#
# While it's true that writing to stderr is a nasty habit, I don't
# believe that that's what's causing libtool to fail.  From what I can
# tell, the problem is caused by libtool not recognizing icc as either
# gcc or a vendor compiler.  It therefore sets can_build_shared to "no"
# and refuses to build a shared library.
#
# The kludge that I'm currently using is to detect the Intel compiler,
# trick libtool into thinking it's running under Solaris -- Sun's
# compiler uses similarly named flags to Intel's -- invoke
#
# Determine if the C compiler is likely to be the Intel Linux compiler.
AC_DEFUN([AC_PROG_CC_INTEL_LINUX],
[AC_REQUIRE([AC_CANONICAL_HOST])
AC_REQUIRE([AC_PROG_CC])
AC_CACHE_CHECK([for the Intel Linux C compiler],
   ac_cv_prog_cc_intel_linux,
   [ac_cv_prog_cc_intel_linux=no
    case "$host_os" in
     *linux*)
       test `$CC -V 2>&1 | egrep -c 'Intel.*C.*Compiler'` -gt 0 && ac_cv_prog_cc_intel_linux=yes
       ;;
    esac
   ])
if test "$ac_cv_prog_cc_intel_linux" = yes; then
   AC_DEFINE([INTEL_LINUX_CC], ,
     [Define if your C compiler is the Intel compiler for Linux.])
fi
])

AC_PROG_CC_INTEL_LINUX
if test "$ac_cv_prog_cc_intel_linux" = yes; then
   true_host_os=$host_os
   host_os=solaris_no_just_kidding
fi
AM_PROG_LIBTOOL
if test "$ac_prog_cc_intel_linux" = yes; then
   host_os=$true_host_os
fi
####################################################################################

# Check for GUI Tool Kit.
AC_ARG_ENABLE(qt,    [  --enable-qt             Use Qt3 as tool kit], use_qt3=yes, use_qt3=no)
AC_ARG_ENABLE(qt4,    [  --enable-qt4            Use Qt4 as tool kit], use_qt4=yes, use_qt4=no)
AC_ARG_ENABLE(qt6,    [  --enable-qt6            Use Qt6 as tool kit], use_qt6=yes, use_qt6=no)
AM_CONDITIONAL(BUILD_QT, test x$use_qt3 = xyes -o x$use_qt4 = xyes -o x$use_qt6 = xyes)

if test "$use_qt3" = yes; then
# Check for Qt.
	AC_DEFINE(USE_QT,,[Use qt])
	AC_DEFINE(USE_QT3,,[Use qt3])
	QMAINWINDOW=QMainWindow
	QTABDIALOG=QTabDialog
	BNV_HAVE_QT
elif test "$use_qt4" = yes; then
	AC_DEFINE(USE_QT,,[Use qt])
	AC_DEFINE(USE_QT4,,[Use qt4])
	QMAINWINDOW=Q3MainWindow
	QTABDIALOG=Q3TabDialog

	AC_ARG_WITH(Qt-dir,  [  --with-Qt-dir=DIR  Prefix where Qt is installed])
	if test "x$with_Qt_dir" != "x" ; then
		QTDIR=$with_Qt_dir
	else
		QTDIR=/usr/share/qt4
	fi
	QT_MOC="$QTDIR/bin/moc"
	QT_UIC="$QTDIR/bin/uic"
	QT_CXXFLAGS="-DQT3_SUPPORT -I$QTDIR/include -I$QTDIR/include/QtCore -I$QTDIR/include/QtGui -I$QTDIR/include/QtOpenGL -I$QTDIR/include/Qt3Support"
	QT_LIBS="-L$QTDIR/lib -lQtCore -lQt3Support -lQtGui -lQtOpenGL"
	AC_SUBST(QT_MOC)
	AC_SUBST(QT_UIC)
	AC_SUBST(QT_CXXFLAGS)
	AC_SUBST(QT_LIBS)
elif test "$use_qt6" = yes; then
	AC_DEFINE(USE_QT,,[Use qt])
	AC_DEFINE(USE_QT6,,[Use qt6])
	QMAINWINDOW=QMainWindow
	QTABDIALOG=QDialog

	AC_PATH_PROG(PKG_CONFIG, pkg-config, no)
	if test "x$PKG_CONFIG" = "xno" ; then
		AC_MSG_ERROR([pkg-config not found; required for Qt6 detection])
	fi
	$PKG_CONFIG --exists Qt6Widgets || AC_MSG_ERROR([Qt6Widgets not found via pkg-config])
	$PKG_CONFIG --exists Qt6OpenGLWidgets || AC_MSG_ERROR([Qt6OpenGLWidgets not found via pkg-config])
	QT_CXXFLAGS="`$PKG_CONFIG --cflags Qt6Widgets Qt6Gui Qt6Core Qt6OpenGLWidgets`"
	QT_LIBS="`$PKG_CONFIG --libs Qt6Widgets Qt6Gui Qt6Core Qt6OpenGLWidgets`"
	AC_SUBST(QT_CXXFLAGS)
	AC_SUBST(QT_LIBS)

	AC_PATH_PROG(QT_MOC, moc, moc)
	AC_PATH_PROG(QT_UIC, uic, uic)
	AC_SUBST(QT_MOC)
	AC_SUBST(QT_UIC)
else
# Check for GTK+.
	AC_DEFINE(USE_GTK,,[Use GTK+])
	AC_ARG_ENABLE(gtk2,  [  --enable-gtk2           Use GTK+2 as tool kit],
	[AM_PATH_GTK_2_0(,,AC_MSG_ERROR([Cannot find proper GTK+2 version]))],
	[AM_PATH_GTK(,,AC_MSG_ERROR([Cannot find proper GTK+ version]))])
fi
AC_SUBST(QMAINWINDOW)
AC_SUBST(QTABDIALOG)

# Check for zlib:
AC_ARG_WITH(zlib-prefix,  [  --with-zlib-prefix=DIR  Prefix where zlib is installed])
if test "x$with_zlib_prefix" != "x" ; then
 zlib_LDOPTS="-L$with_zlib_prefix/lib"
 CPPFLAGS="-I$with_zlib_prefix/include ${CPPFLAGS}"
fi
AC_CHECK_HEADER(zlib.h, ,AC_MSG_ERROR([Missing zlib header file]))
AC_CHECK_LIB([z], [gzopen], ,AC_MSG_ERROR([Missing zlib libraries]), $zlib_LDOPTS)
ZLIB_LIBS="$zlib_LDOPTS -lz"
AC_SUBST(ZLIB_LIBS)

# Check for jpeg libraries:
AC_ARG_WITH(jpeg-prefix,  [  --with-jpeg-prefix=DIR  Prefix where libjpeg is installed])
if test "x$with_jpeg_prefix" != "x" ; then
 jpeg_LDOPTS="-L$with_jpeg_prefix/lib"
 CPPFLAGS="-I$with_jpeg_prefix/include ${CPPFLAGS}"
fi
AC_CHECK_HEADER(jpeglib.h, ,AC_MSG_ERROR([Missing jpeg header file]))
AC_CHECK_LIB([jpeg], [jpeg_set_defaults], ,AC_MSG_ERROR([Missing jpeg libraries]), $jpeg_LDOPTS)
JPEG_LIBS="$jpeg_LDOPTS -ljpeg"		   
AC_SUBST(JPEG_LIBS)

# Check for png libraries:
AC_ARG_WITH(png-prefix,  [  --with-png-prefix=DIR   Prefix where libpng is installed])
if test "x$with_png_prefix" != "x" ; then
 png_LDOPTS="-L$with_png_prefix/lib"
 CPPFLAGS="-I$with_png_prefix/include ${CPPFLAGS}"
fi
AC_CHECK_HEADER(png.h, ,AC_MSG_ERROR([Missing png header file]))
AC_CHECK_LIB([png], [png_write_image], ,AC_MSG_ERROR([Missing png libraries]), $png_LDOPTS -lz)
PNG_LIBS="$png_LDOPTS -lpng -lz"
AC_SUBST(PNG_LIBS)

LIBS=""
# Check for freetype2 libraries:
#AC_CHECK_FT2(,,AC_MSG_ERROR([Cannot find proper FreeType2 version]))
#LIBS="$FT2_LIBS"
#AC_CHECK_FUNCS(FT_Get_PS_Font_Info)

AC_CHECK_FT2(,with_freetype2=yes,with_freetype2=no)
if test "x$with_freetype2" = "xyes" ; then
	LIBS="$FT2_LIBS"
	AC_CHECK_FUNCS(FT_Get_PS_Font_Info)
	AC_DEFINE(HAVE_FREETYPE2,,[Have freetype2])
else
	AC_MSG_WARN(Freetype2 functions are dropped from GSAF/OpenGL)
fi

LIBS=""
# Checks for iconv libraries:
AC_ARG_WITH(iconv-prefix,  [  --with-iconv-prefix=DIR Prefix where iconv is installed])
if test "x$with_iconv_prefix" != "x" ; then
 iconv_LDOPTS="-L$with_iconv_prefix/lib"
 CPPFLAGS="-I$with_iconv_prefix/include ${CPPFLAGS}"
fi
AC_ARG_WITH(libiconv, [  --with-libiconv         Use the libiconv library ],,with_libiconv=maybe)
found_iconv=no
if test "x$with_libiconv" != "xyes" ; then
   # 
   # Check in the C library 
   #
   AC_CHECK_FUNC(iconv_open, with_libiconv=no; found_iconv=yes)
fi
if test "x$with_libiconv" != "xno" ; then
   #
   # Check for libiconv
   #
   AC_CHECK_LIB(iconv, libiconv_open, with_libiconv=yes; found_iconv=yes, found_iconv=no, $iconv_LDOPTS)
   if test "x$with_libiconv" = "xyes" ; then
  	LIBS="$LIBS $iconv_LDOPTS -liconv"
	AC_DEFINE(HAVE_LIBICONV,,[Have libiconv])
   fi
   if test "x$found_iconv" = "xno" ; then
	AC_CHECK_LIB(giconv, libiconv_open, with_libiconv=yes; found_iconv=yes, found_iconv=no, $iconv_LDOPTS)
	if test "x$with_libiconv" = "xyes" ; then
	   LIBS="$LIBS $iconv_LDOPTS -lgiconv"
	   AC_DEFINE(HAVE_LIBGICONV,,[Have libgiconv])
	fi
   fi
fi
if test "x$found_iconv" = "xno" ; then
   AC_MSG_ERROR([No iconv() implementation found in C library or libiconv])
fi

# Check for dl libraries:
AC_CHECK_LIB([dl], [dlopen], have_libdl=yes, have_libdl=no)
if test "x$have_libdl" = "xyes"; then
	dl_LDOPTS=-ldl
fi

# Check for gc libraries:
AC_ARG_WITH(gc-prefix,  [  --with-gc-prefix=DIR    Prefix where libgc is installed])
if test "x$with_gc_prefix" != "x" ; then
    gc_LDOPTS="-L$with_gc_prefix/lib $dl_LDOPTS"
    CPPFLAGS="-I$with_gc_prefix/include ${CPPFLAGS}"
fi

have_gc=yes
# save_LIBS="$LIBS"
AC_CHECK_LIB([gc], [GC_malloc], , have_gc=no, $gc_LDOPTS)
if test "x$have_gc" = "xyes" ; then
   LIBS="$LIBS $gc_LDOPTS"
   AC_LANG_PUSH(C++)
   AC_CHECK_HEADER(gc_cpp.h, ,[AC_CHECK_HEADER(gc/gc_cpp.h, [AC_DEFINE(HAVE_GCDIR,,[Is this debian?])],have_gc=no)])
   AC_LANG_POP(C++)
fi
if test "x$have_gc" = "xno" ; then
    echo "System does not have Boehm's GC with C++ functionalities ... configure GC distributed with GSAF/OpenGL"
    (cd gc && ./configure --enable-cplusplus --prefix="$prefix")
    CPPFLAGS="-I../gc/include ${CPPFLAGS}"
    LOCAL_LIBGC_SRC=../gc/libgc.la
    LOCAL_LIBGC_TOP=gc
fi
AC_SUBST(LOCAL_LIBGC_SRC)
AC_SUBST(LOCAL_LIBGC_TOP)

# LIBS="$save_LIBS"
# Checks for m libraries:
#AC_CHECK_LIB(m, pow, ,AC_MSG_ERROR([Missing m libraries]))
LIBS="$LIBS -lm"

AC_PATH_X
if test "x$no_x" = "xyes" ; then
	X_LIBS_X11=
else
	X_LIBS_X11="-lX11"
fi
AC_SUBST(X_LIBS_X11)

case $host_os in
	*darwin*) is_darwin=yes ;;
	*) is_darwin=no ;;
esac

# Checks for GL libraries:
if test "x$is_darwin" = "xyes" -a "x$use_qt6" = "xyes" ; then
	AC_CHECK_HEADER([OpenGL/gl.h], ,AC_MSG_ERROR([Missing OpenGL header file]))
	AC_CHECK_HEADER([OpenGL/glu.h], ,AC_MSG_ERROR([Missing OpenGL GLU header file]))
	LIBS="-framework OpenGL $LIBS"
	AC_DEFINE(HAVE_TESS,,[Have gluTessBeginPolygon])
else
	AC_ARG_WITH(GL-prefix,  [  --with-GL-prefix=DIR    Prefix where GL is installed])
	if test "x$with_GL_prefix" != "x" ; then
	 GL_LDOPTS="-L$with_GL_prefix/lib"
	 CPPFLAGS="-I$with_GL_prefix/include ${CPPFLAGS}"
	fi
	AC_CHECK_HEADER(GL/gl.h, ,AC_MSG_ERROR([Missing GL header file]))

	case $host in
	#	*-*-msdos* | *-*-go32* | *-*-mingw32* | *-*-cygwin* | *-*-windows*)
		*-*-mingw32* | *-*-cygwin* | *-*-windows*)
		WIN32="yes"
		;;
	*)
		WIN32="no"
		;;
	esac

	if test $WIN32 = "yes" ; then 
	  LIBS="$LIBS -lopengl32"
	else
	  AC_CHECK_LIB([GL], [glEnd], ,AC_MSG_ERROR([Missing GL libraries]), $GL_LDOPTS)
	fi
	LIBS="$GL_LDOPTS $LIBS"

	# Checks for GLU libraries:
	AC_ARG_WITH(GLU-prefix,  [  --with-GLU-prefix=DIR   Prefix where GLU is installed])
	if test "x$with_GLU_prefix" != "x" ; then
	 GLU_LDOPTS="-L$with_GLU_prefix/lib"
	 CPPFLAGS="-I$with_GLU_prefix/include ${CPPFLAGS}"
	fi
	AC_CHECK_HEADER(GL/glu.h, ,AC_MSG_ERROR([Missing GLU header file]))
	if test $WIN32 = "yes" ; then 
	  LIBS="$LIBS -lglu32"
	else
	  AC_CHECK_LIB([GLU],[gluTessBeginPolygon],with_tess=yes,with_tess=no,$GLU_LDOPTS)
	  if test "x$with_tess" = "xyes" ; then
		LIBS="-lGLU $GLU_LDOPTS $LIBS"
		AC_DEFINE(HAVE_TESS,,[Have gluTessBeginPolygon])
	  else
		AC_CHECK_LIB([GLU],[gluUnProject],,AC_MSG_ERROR([Missing proper version of GLU libraries]), $GLU_LDOPTS)
		LIBS="-lGLU $GLU_LDOPTS $LIBS"
	  fi
	fi
fi

# enable inline mode
#AC_ARG_ENABLE(inline,    [  --enable-inline         enable inline mode],
#	 use_inline=yes, use_inline=no)
#if test "$use_inline" = yes; then
#	AC_DEFINE(USE_INLINE,,[Use inline])
