class MySpinBox : public QSpinBox
{
	Q_OBJECT
public:
	MySpinBox(int digits, int minValue, int maxValue, int step=1, QWidget *parent=0, const char *name=0);
	~MySpinBox () {if (val) delete val;};
	QDoubleValidator *val;
	QString mapValueToText( int value );
	int mapTextToValue( bool *ok );

private:
	double factor;
	int digits;
};

class gsglDialog : public QDialog
{
	Q_OBJECT

public:
	gsglDialog (gsglPage *p, bool, QWidget *parent=0, const char *name=0, bool modal=FALSE, WFLAGS fl=0);
	~gsglDialog () {};

	QHBoxLayout *buttonbox;
	QVBoxLayout *vbox;
	QPushButton *okPushButton;
	QPushButton *cancelPushButton;
	QPushButton *defaultPushButton;
	bool with_default;
	gsglPage *p;

protected:
	void addbuttons ();
	void addbuttons_close ();

public slots:  
        virtual void setdefault ();
        virtual void my_accept ();
        virtual void my_reject ();
};

class gsglScaleDialog : public gsglDialog
{
	Q_OBJECT

public:
	gsglScaleDialog (gsglPage *p, int dim, QWidget *parent=0, const char *name=0, bool modal=FALSE, WFLAGS fl=0);
	~gsglScaleDialog () {};
	void get_result (int *, int *, int *);

	QHBoxLayout *xbox;
	QHBoxLayout *ybox;
	QHBoxLayout *zbox;
	QLabel *caption;
	QLabel *x;
	QLabel *y;
	QLabel *z;
	QLabel *mm1;
	QLabel *mm2;
	QLabel *mm3;
	MySpinBox *spinx;
	MySpinBox *spiny;
	MySpinBox *spinz;

public slots:  
	void setdefault ();
        void cross_x (int i);
        void cross_y (int i);
        void cross_z (int i);
        void my_accept ();
        void my_reject ();

private:
	int dim;
};

class ColorButton : public QPushButton
{
	Q_OBJECT

public:
	ColorButton (QWidget *parent, int r, int g, int b, const char *name=0);
        ~ColorButton () {};
	void setcolor (QColor);
	QColor inqcolor () {return c;};

public slots:
        void select_color ();

private:
        QPixmap p;
        QColor c;
};

