# required packages from macports.org
#    libpng
#    jpeg
#    libiconv
#    gtk2
# required Xquartz

F77=ifort CC=gcc-mp-5 CXX=g++-mp-5 CFLAGS="-g -O2 -D_XOPEN_SOURCE" AR="libtool" AR_FLAGS="-static -o " CPPFLAGS="-fpermissive -Wwrite-strings" ./configure --enable-gtk2 --with-jpeg-prefix=/opt/local --with-png-prefix=/opt/local --with-iconv-prefix=/opt/local --with-GL-prefix=/opt/X11